{
  "name": "vbl-pro",
  "module": "src/main.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/main.ts",
    "dev": "bun run --watch src/main.ts",
    "check": "bun run scripts/build.ts check",

    "build:native": "bun run scripts/build.ts native",

    "clean:build": "bun -e \"require('node:fs').rmSync('./build',{recursive:true,force:true})\"",
    "clean:release": "bun -e \"require('node:fs').rmSync('./release',{recursive:true,force:true})\"",

    "build": "bun run scripts/build.ts build",
    "compile": "bun run scripts/build.ts compile"
  },
  "devDependencies": {
    "@napi-rs/cli": "latest",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "latest"
  },
  "dependencies": {}
}
