{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vbl-pro",
  "version": "0.1.1",
  "identifier": "com.vbl.pro",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VBL Pro",
        "width": 860,
        "height": 720,
        "minWidth": 540,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
